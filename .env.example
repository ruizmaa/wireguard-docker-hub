# Copy this file to .env and fill in real values for this deployment.

# docker-compose.yml (WireGuard, VPS)
PUID=1000
PGID=1000
TZ=Etc/UTC
SERVERURL=auto
SERVERPORT=51820
PEERS=1
PEERDNS=1.1.1.1,8.8.8.8
INTERNAL_SUBNET=10.13.13.0
ALLOWEDIPS=0.0.0.0/0,::/0

# services/docker-compose.yml (home server)
TZ=Etc/UTC
# Full "host_path:container_path" per mount, so you can use your own container-side names
SYNCTHING_MOUNT_1=/path/to/data1:/data1
SYNCTHING_MOUNT_2=/path/to/data2:/data2
JELLYFIN_MEDIA_1=/path/to/media:/media
JELLYFIN_MEDIA_2=/path/to/media2:/media2

# Host ports, only needed if you want to change them from these defaults
ADGUARD_WEB_PORT=8080
ADGUARD_DNS_PORT=53
ADGUARD_SETUP_PORT=3000
JELLYFIN_WEB_PORT=8096
JELLYFIN_DISCOVERY_PORT=7359
SYNCTHING_WEB_PORT=8384
SYNCTHING_SYNC_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027

# scripts/fix-home-net.sh (home server firewall)
# Comma-separated list of IP@MAC pairs
# Give these devices a DHCP reservation on your router so their IPs don't change
# SSH and the services become reachable only from these
# WireGuard (VPN) access is always allowed regardless of this list.
TRUSTED_LAN_DEVICES=192.168.1.1@aa:bb:cc:dd:ee:ff,192.168.1.2@11:22:33:44:55:66
