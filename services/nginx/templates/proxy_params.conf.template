# Shared by every proxied service's HTTPS server block in conf.d/. Expects `set $backend ...;` and `set $backend_scheme ...;` first.
location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Needed for Jellyfin's WebSocket connection (remote control, live "now playing", sync play).
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Proxmox/PBS serve self-signed certs from the LAN: this hop is encrypted, not authenticated.
    proxy_ssl_verify off;
    proxy_pass $backend_scheme://$backend;
}
