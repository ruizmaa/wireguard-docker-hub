worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Keeps the version out of the Server header and off any response body
    server_tokens off;

    # No proxy_intercept_errors, so a backend's own 404 still passes through untouched
    error_page 403 404 413 500 502 503 504 /__nginx_error.html;

    # 497 is http:// on the https port. It goes out as 400, so a page would name the wrong cause
    error_page 497 =301 https://$host:${NGINX_HTTPS_PORT}$request_uri;

    # Substituted into error.html's {{MESSAGE}}, $status is the code being served.
    map $status $error_message {
        default 'The service returned an unexpected response.';
        403     'Access to this resource is denied.';
        404     'That address does not exist on this service.';
        413     'The upload is larger than this service accepts.';
        500     'The service hit an internal error.';
        502     'The service is not responding. Its container may be stopped or still starting.';
        503     'The service is temporarily unavailable.';
        504     'The service took too long to respond.';
    }

    # Single wildcard cert for every *.home.arpa server block below
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    # LAN vs WireGuard(VPN) zone, based on the client's source IP. Not enforced
    # anywhere yet (no allow/deny) -- exposed as the X-Client-Zone response
    # header, so it's verifiable before any access policy is built on top of it.
    geo $zone {
        default       external;
        ${LAN_SUBNET} lan;
        ${VPN_SUBNET} vpn;
    }
    add_header X-Client-Zone $zone always;

    # 127.0.0.11 is Docker's embedded DNS -- re-resolves each proxied service's name on
    # every request (cached for 10s) instead of once at nginx startup, so recreating a
    # container (image update, restart) doesn't leave its server block pointing at a stale IP.
    # Inherited by every server block below -- see conf.d/*.conf's `set $backend` lines.
    resolver 127.0.0.11 valid=10s;

    # Used by proxy_params.conf's WebSocket headers: "upgrade" on a real Upgrade request, "close" otherwise.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    include /etc/nginx/conf.d/*.conf;
}
