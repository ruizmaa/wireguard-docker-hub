# Test-only values for .github/workflows/test-services.yml, copied to services/.env on deploy
# Dummy/throwaway, never hand-edit services/.env in a real checkout from this

TZ=Etc/UTC

# Dummy RFC 5737 ranges, only need to be valid CIDRs, no real network is tested here
LAN_SUBNET=192.0.2.0/24
VPN_SUBNET=198.51.100.0/24
TRUENAS_IP=192.0.2.10

# Scratch data. Wiped and recreated by the workflow on every run, never real data
SYNCTHING_MOUNT_1=/opt/test-env-data/syncthing1:/data1
SYNCTHING_MOUNT_2=/opt/test-env-data/syncthing2:/data2
LOCAL_MOUNT_MEDIA_PATH=/opt/test-env-data/nas-media
DOCKGE_STACKS_DIR=/opt/test-env-data/dockge-stacks

HOMEPAGE_ALLOWED_HOSTS=localhost:13001,127.0.0.1:13001

GLANCES_USERNAME=glances
GLANCES_PASSWORD=test-password-only

# Host ports, offset from production defaults so both stacks can run on the same host at once
NGINX_HTTP_PORT=8880
NGINX_HTTPS_PORT=8443
ADGUARD_WEB_PORT=18080
ADGUARD_DNS_PORT=10053
ADGUARD_SETUP_PORT=13000
HOMEPAGE_WEB_PORT=13001
JELLYFIN_WEB_PORT=18096
JELLYFIN_DISCOVERY_PORT=17359
SYNCTHING_WEB_PORT=18384
SYNCTHING_SYNC_PORT=32000
SYNCTHING_DISCOVERY_PORT=31027
DOCKGE_WEB_PORT=15001
GLANCES_WEB_PORT=61209
QBITTORRENT_WEB_PORT=18081
QBITTORRENT_TORRENT_PORT=16881
LIDARR_WEB_PORT=18686
RADARR_WEB_PORT=17878
SONARR_WEB_PORT=18989
PROWLARR_WEB_PORT=19696
